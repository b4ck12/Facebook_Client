<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <application
    android:allowBackup="true"
    android:icon="@android:drawable/sym_def_app_icon"
    android:label="@string/app_name"
    android:roundIcon="@android:drawable/sym_def_app_icon"
    android:supportsRtl="true"
    android:theme="@style/Theme.FacebookClient">

    <!-- Màn hình Đăng nhập 1 chạm / Chọn tài khoản Demo ([D6-TD]) -->
    <activity
      android:name=".features.auth.AccountChooserActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Màn hình chính (Main Shell 4 Tab) -->
    <activity
      android:name=".MainActivity"
      android:exported="false"
      android:windowSoftInputMode="adjustPan" />

    <!--
      Màn hình Tạo bài viết mới ([D4-TD]):
      windowSoftInputMode="adjustResize" giúp thanh công cụ "Photo/video" ở đáy
      tự động đẩy lên nằm ngay trên bàn phím ảo khi người dùng gõ văn bản.
    -->
    <activity
      android:name=".features.feed.CreatePostActivity"
      android:exported="false"
      android:windowSoftInputMode="adjustResize" />

  </application>

</manifest>
