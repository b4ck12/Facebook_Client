<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/friend_request_avatar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_profile"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/friend_request_name"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"

        android:text="Nguyen Van Anh"
        android:textStyle="bold"
        android:textColor="@color/fb_text_primary"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"

        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeMaxTextSize="30sp"
        app:autoSizeStepGranularity="1sp"

        app:layout_constraintStart_toEndOf="@id/friend_request_avatar"
        app:layout_constraintTop_toTopOf="@id/friend_request_avatar"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button
        android:id="@+id/btn_accept_request"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/fb_blue"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="48dp"
        android:text="@string/btn_accept"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:layout_marginStart="16dp"
        app:cornerRadius="6dp"
        app:layout_constraintEnd_toStartOf="@id/btn_reject_request"
        app:layout_constraintStart_toEndOf="@id/friend_request_avatar"
        app:layout_constraintTop_toBottomOf="@id/friend_request_name" />

    <!-- 4. Nút XÓA (Màu xám) -->
    <Button
        android:id="@+id/btn_reject_request"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#E2E5E9"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="48dp"
        android:text="@string/btn_decline"
        android:textColor="@color/fb_text_primary"
        android:textSize="13sp"
        app:cornerRadius="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_accept_request"
        app:layout_constraintTop_toTopOf="@id/btn_accept_request"/>


</androidx.constraintlayout.widget.ConstraintLayout>