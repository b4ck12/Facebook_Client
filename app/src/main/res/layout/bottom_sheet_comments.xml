<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fb_surface"
    android:orientation="vertical">

    <!-- Thanh kéo BottomSheet (Drag Handle) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_circle_button"
        android:backgroundTint="@color/fb_divider" />

    <!-- Header: Tiêu đề "Bình luận" & Nút đóng X -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tv_comments_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Bình luận"
            android:textColor="@color/fb_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/ib_close_comments"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đóng bình luận"
            android:src="@drawable/ic_close"
            app:tint="@color/fb_action_gray" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/fb_divider_light" />

    <!-- Khung hiển thị danh sách Comment & Trạng thái rỗng -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_comments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            tools:listitem="@layout/item_comment" />

        <TextView
            android:id="@+id/tv_empty_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="Chưa có bình luận nào.\nHãy là người đầu tiên bình luận!"
            android:textColor="@color/fb_text_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/fb_divider_light" />

    <!-- Thanh nhập bình luận (Input Bar - Text-only) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fb_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <!-- Avatar người dùng hiện tại -->
        <ImageView
            android:id="@+id/iv_current_user_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Current user avatar"
            android:src="@drawable/bg_avatar_placeholder" />

        <!-- Ô nhập nội dung bình luận (Text thuần túy) -->
        <EditText
            android:id="@+id/et_comment_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_comment_bubble"
            android:hint="Viết bình luận công khai..."
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:textColor="@color/fb_text_primary"
            android:textColorHint="@color/fb_text_hint"
            android:textSize="14sp" />

        <!-- Nút Gửi bình luận -->
        <ImageButton
            android:id="@+id/ib_send_comment"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Gửi bình luận"
            android:src="@drawable/ic_send"
            app:tint="@color/fb_blue" />

    </LinearLayout>

</LinearLayout>