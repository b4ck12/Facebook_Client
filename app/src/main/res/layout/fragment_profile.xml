<?xml version="1.0" encoding="utf-8"?>
<!--
  Giao diện Màn hình Trang cá nhân (Profile Screen - [D5-PD], [D6-TQH]).
  Tuân thủ chuẩn Facebook Client Design System (03_DESIGN_SYSTEM.md):
  1. Header đỉnh: Ảnh bìa 200dp (iv_profile_cover) + Avatar tròn 120dp đè 50% lên mép dưới ảnh bìa.
  2. Thông tin cá nhân: Tên hiển thị (22sp bold), Tiểu sử ngắn (bio), Nút "Chỉnh sửa trang cá nhân" (btn_edit_profile).
  3. Thanh phân chia Tab (TabLayout: tab_layout_profile): Tab "Ảnh & Video" (Photos) và Tab "Bài viết" (Posts).
  4. Lưới ảnh 3 cột (rv_profile_photos): Nhúng PhotoGridAdapter với các item_photo_grid.xml ô vuông 1:1.
  5. Danh sách bài viết (rv_profile_posts): Hiển thị bài viết cá nhân bằng PostAdapter.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/fb_surface">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical">

    <!-- Cover 200dp + nửa avatar 60dp nằm bên dưới cover. -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="260dp">
      <ImageView android:id="@+id/iv_profile_cover"
          android:layout_width="match_parent" android:layout_height="200dp"
          android:scaleType="centerCrop" android:background="@color/fb_surface_variant"
          android:contentDescription="@string/fp_cover" />
      <com.google.android.material.imageview.ShapeableImageView android:id="@+id/iv_profile_avatar"
          android:layout_width="120dp" android:layout_height="120dp"
          android:layout_gravity="bottom|center_horizontal"
          android:src="@drawable/ic_profile" android:scaleType="centerCrop"
          android:contentDescription="@string/fp_user_avatar"
          app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
          app:strokeColor="@color/white" app:strokeWidth="4dp" />
    </FrameLayout>

    <TextView android:id="@+id/tv_profile_name"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center"
        android:textSize="22sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"
        android:textColor="@color/fb_text_primary" tools:text="Nguyễn Văn An" />
    <View android:layout_width="match_parent" android:layout_height="8dp"
        android:layout_marginTop="16dp" android:background="@color/fb_background" />
    <com.google.android.material.tabs.TabLayout android:id="@+id/tab_layout_profile"
        android:layout_width="match_parent" android:layout_height="48dp"
        app:tabMode="fixed" app:tabGravity="fill" app:tabIndicatorColor="@color/fb_blue_dark"
        app:tabSelectedTextColor="@color/fb_blue_dark" app:tabTextColor="@color/fb_text_secondary" />

    <LinearLayout android:id="@+id/layout_profile_error"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="16dp"
        android:visibility="gone">
      <TextView android:id="@+id/tv_profile_error"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:gravity="center" android:textSize="14sp" android:textColor="@color/fb_text_secondary" />
      <com.google.android.material.button.MaterialButton android:id="@+id/btn_profile_retry"
          android:layout_width="wrap_content" android:layout_height="48dp"
          android:text="@string/fp_retry" app:backgroundTint="@color/fb_blue_dark" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_change_profile"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/fp_change_profile"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:visibility="gone"
        app:backgroundTint="@color/fb_blue_dark"
        app:cornerRadius="8dp"
        tools:visibility="visible" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="120dp">
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_profile_posts"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:nestedScrollingEnabled="false" tools:listitem="@layout/item_post" />
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_profile_photos"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:nestedScrollingEnabled="false" android:visibility="gone"
          tools:listitem="@layout/item_photo_grid" />
      <TextView android:id="@+id/tv_profile_empty"
          android:layout_width="match_parent" android:layout_height="120dp"
          android:gravity="center" android:padding="16dp" android:textSize="14sp"
          android:textColor="@color/fb_text_secondary" android:visibility="gone" />
      <ProgressBar android:id="@+id/pb_profile_loading"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_gravity="center" android:visibility="gone" />
    </FrameLayout>
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
