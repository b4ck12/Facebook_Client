<?xml version="1.0" encoding="utf-8"?>
<!--
  Giao diện một thẻ bài viết trên Bảng tin (Post Card - [D3-ML]).
  Tuân thủ 100% đặc tả Design System (03_DESIGN_SYSTEM.md mục 5.5) và Mobile App.pdf:
  1. Header: Avatar tròn (40dp), Tên tác giả (15sp Bold), Thời gian đăng (12sp) + Icon Public (12dp), Nút [...] (ib_more_options).
  2. Body: Văn bản nội dung (tv_post_content) và Ảnh đính kèm (iv_post_image - maxHeight 400dp, centerCrop).
  3. Footer Stats: Icon Like xanh + Số lượt thích (tv_like_count) bên trái, Số bình luận (tv_comment_count) bên phải.
  4. Action Bar: Chia đều 3 cột (Like - Comment - Share) kèm hiệu ứng ripple chuẩn Material.
-->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/layout_post_card"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@color/fb_surface"
  android:orientation="vertical">

  <!-- ========================================================================= -->
  <!-- 1. PHẦN ĐẦU BÀI VIẾT (HEADER: Avatar + Tên + Thời gian + Nút Tùy chọn)     -->
  <!-- ========================================================================= -->
  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/layout_post_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_sm">

    <!-- Ảnh đại diện người đăng (40dp x 40dp) -->
    <ImageView
      android:id="@+id/iv_author_avatar"
      android:layout_width="@dimen/avatar_size_medium"
      android:layout_height="@dimen/avatar_size_medium"
      android:contentDescription="@string/cd_author_avatar"
      android:scaleType="centerCrop"
      android:src="@drawable/bg_avatar_placeholder"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

    <!-- Tên người đăng bài (15sp Bold) -->
    <TextView
      android:id="@+id/tv_author_name"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_sm"
      android:layout_marginEnd="@dimen/spacing_sm"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/fb_text_primary"
      android:textSize="@dimen/text_size_title"
      android:textStyle="bold"
      app:layout_constraintEnd_toStartOf="@id/ib_more_options"
      app:layout_constraintStart_toEndOf="@id/iv_author_avatar"
      app:layout_constraintTop_toTopOf="@id/iv_author_avatar"
      tools:text="Nguyễn Văn An" />

    <!-- Dòng thời gian đăng + Icon quyền riêng tư Public -->
    <LinearLayout
      android:id="@+id/layout_post_meta"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_sm"
      android:layout_marginTop="2dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      app:layout_constraintStart_toEndOf="@id/iv_author_avatar"
      app:layout_constraintTop_toBottomOf="@id/tv_author_name">

      <TextView
        android:id="@+id/tv_post_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/fb_text_secondary"
        android:textSize="@dimen/text_size_caption"
        tools:text="5 phút trước" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_xs"
        android:text="·"
        android:textColor="@color/fb_text_secondary"
        android:textSize="@dimen/text_size_caption"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

      <ImageView
        android:id="@+id/iv_privacy_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:contentDescription="@string/cd_privacy_icon"
        android:src="@drawable/ic_public"
        app:tint="@color/fb_text_secondary" />

    </LinearLayout>

    <!-- Nút 3 chấm ngang [...] ở góc phải -->
    <ImageButton
      android:id="@+id/ib_more_options"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="More options"
      android:padding="@dimen/spacing_sm"
      android:scaleType="centerInside"
      android:src="@drawable/ic_more_horiz"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:tint="@color/fb_action_gray"
      tools:ignore="HardcodedText" />

  </androidx.constraintlayout.widget.ConstraintLayout>

  <!-- ========================================================================= -->
  <!-- 2. PHẦN NỘI DUNG BÀI VIẾT (BODY: Văn bản + Ảnh đính kèm)                  -->
  <!-- ========================================================================= -->
  <TextView
    android:id="@+id/tv_post_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:lineSpacingExtra="3dp"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_sm"
    android:textColor="@color/fb_text_primary"
    android:textSize="@dimen/text_size_title"
    tools:text="Cuối tuần đi săn mây Đà Lạt cùng hội bạn thân, thời tiết se lạnh tuyệt vời quá mọi người ơi!" />

  <!-- Ảnh đính kèm bài viết (Ẩn đi nếu bài viết chỉ có chữ) -->
  <ImageView
    android:id="@+id/iv_post_image"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:adjustViewBounds="true"
    android:background="@color/fb_surface_variant"
    android:contentDescription="@string/cd_post_image_preview"
    android:maxHeight="400dp"
    android:scaleType="centerCrop"
    android:visibility="gone"
    tools:layout_height="240dp"
    tools:visibility="visible" />

  <!-- ========================================================================= -->
  <!-- 3. THỐNG KÊ TƯƠNG TÁC (FOOTER STATS: Số lượt thích & Số bình luận)         -->
  <!-- ========================================================================= -->
  <LinearLayout
    android:id="@+id/layout_post_stats"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingVertical="@dimen/spacing_sm">

    <!-- Biểu tượng Like nhỏ màu xanh -->
    <ImageView
      android:id="@+id/iv_stats_like_badge"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:importantForAccessibility="no"
      android:src="@drawable/ic_like_filled"
      app:tint="@color/fb_like_blue" />

    <!-- Số lượt thích -->
    <TextView
      android:id="@+id/tv_like_count"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:layout_weight="1"
      android:textColor="@color/fb_text_secondary"
      android:textSize="@dimen/text_size_caption"
      tools:text="24 lượt thích" />

    <!-- Số lượng bình luận -->
    <TextView
      android:id="@+id/tv_comment_count"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="@color/fb_text_secondary"
      android:textSize="@dimen/text_size_caption"
      tools:text="3 bình luận" />

  </LinearLayout>

  <!-- Đường kẻ mỏng ngăn cách phần thống kê và thanh nút bấm -->
  <View
    android:id="@+id/view_action_divider"
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginHorizontal="@dimen/spacing_md"
    android:background="@color/fb_divider_light" />

  <!-- ========================================================================= -->
  <!-- 4. THANH THAO TÁC 3 CỘT (ACTION BAR: Thích - Bình luận - Chia sẻ)          -->
  <!-- ========================================================================= -->
  <LinearLayout
    android:id="@+id/layout_post_actions"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- Cột 1: Nút Thích (Like) -->
    <LinearLayout
      android:id="@+id/layout_like_action"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="?attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/iv_like_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_like_outline"
        app:tint="@color/fb_action_gray" />

      <TextView
        android:id="@+id/tv_like_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="Thích"
        android:textColor="@color/fb_action_gray"
        android:textSize="@dimen/text_size_action"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    </LinearLayout>

    <!-- Cột 2: Nút Bình luận (Comment) -->
    <LinearLayout
      android:id="@+id/layout_comment_action"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="?attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/iv_comment_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_comment"
        app:tint="@color/fb_action_gray" />

      <TextView
        android:id="@+id/tv_comment_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="Bình luận"
        android:textColor="@color/fb_action_gray"
        android:textSize="@dimen/text_size_action"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    </LinearLayout>

    <!-- Cột 3: Nút Chia sẻ (Share) -->
    <LinearLayout
      android:id="@+id/layout_share_action"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="?attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/iv_share_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_share"
        app:tint="@color/fb_action_gray" />

      <TextView
        android:id="@+id/tv_share_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="Chia sẻ"
        android:textColor="@color/fb_action_gray"
        android:textSize="@dimen/text_size_action"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    </LinearLayout>

  </LinearLayout>

  <!-- Dải phân cách dày 8dp màu xám nhạt (#F0F2F5) giữa các thẻ bài viết -->
  <View
    android:id="@+id/view_post_bottom_separator"
    android:layout_width="match_parent"
    android:layout_height="@dimen/spacing_sm"
    android:background="@color/fb_background" />

</LinearLayout>