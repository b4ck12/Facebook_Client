<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout khung (Skeleton) cho Màn hình Bạn bè & Lời mời kết bạn (Friends).
  Thành viên phụ trách mở rộng chi tiết ([D3-PD]): Phúc Đức (FE).
-->
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/layout_friends_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/fb_background"
  tools:context=".features.friends.FriendsFragment">
  
  <TextView
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      android:layout_marginTop="16dp"
      android:layout_marginStart="16dp"
      android:id="@+id/Friend_text"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Friends"
      android:textColor="@color/fb_text_primary"
      android:textSize="40sp"
      android:textStyle="bold" />
<!-- day la chu FaceBook -->
<Button
    android:id="@+id/your_friends_btn"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:text="your friends"
    android:textSize="14sp"
    android:textStyle="bold"
    android:textColor="@color/fb_text_primary"
    android:paddingEnd="16dp"
    android:paddingStart="16dp"
    app:layout_constraintTop_toBottomOf="@+id/Friend_text"
    app:backgroundTint="#E2E5E9"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:minHeight="0dp"
    android:minWidth="0dp"
    android:layout_marginStart="16dp"
    android:layout_marginTop="12dp"
    app:cornerRadius="18dp"
    app:strokeWidth="0dp"
    app:layout_constraintStart_toStartOf="parent" />
<!-- button your friends -->
<android.view.View
    android:id="@+id/friends_divider"
    android:layout_width="0dp"
    android:layout_height="1dp"
    android:background="#DADDE1"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    app:layout_constraintTop_toBottomOf="@+id/your_friends_btn"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_marginTop="10dp" />
<!-- ke ngan cach giua button your friends va text FriendRequest -->
<LinearLayout
    android:id="@+id/FriendRequest_header"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    app:layout_constraintTop_toBottomOf="@id/friends_divider"
    app:layout_constraintStart_toStartOf="parent"
    android:layout_marginStart="16dp"
    android:layout_marginTop="10dp">
    <TextView
        android:id="@+id/FriendRequest_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Friends request"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/fb_text_primary"/>
    <TextView
        android:id="@+id/FriendRequest_Count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="2"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#E41E3F"/>

</LinearLayout>
<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/rv_FriendRequest"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginStart="12dp"
    app:layout_constraintTop_toBottomOf="@id/FriendRequest_header"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
    tools:listitem="@layout/item_friend_request"
    tools:itemCount="2"/>
</androidx.constraintlayout.widget.ConstraintLayout>

