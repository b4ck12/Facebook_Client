# ============
# Cấu hình IDE (Android Studio / IntelliJ)
# ============
# File cấu hình module riêng của IntelliJ/Android Studio, tự sinh theo máy từng người
*.iml
# Thư mục cấu hình workspace của Android Studio (giao diện, file mở, cache của từng dev)
.idea/

# ============
# Hệ thống Build Gradle & File biên dịch
# ============
# Thư mục lưu cache và tiến trình nền của Gradle daemon khi chạy build
.gradle/
# Toàn bộ thư mục build (cả root build/ và app/build/):
# Chứa file nhị phân (.class, .dex, APK) và code sinh tự động; rất nặng và gây xung đột Git
build/

# ============
# Cấu hình môi trường máy cá nhân
# ============
# Chứa đường dẫn SDK Android cục bộ (sdk.dir=...), mỗi máy cài ở thư mục khác nhau
local.properties

# ============
# Công cụ đo kiểm hiệu năng (Profiling)
# ============
# Nơi Android Studio lưu file chụp màn hình, quay video hoặc đo RAM/CPU Profiler
captures/

# ============
# Biên dịch mã nguồn C/C++ (NDK / CMake)
# ============
# Thư mục cache và file tạm khi biên dịch code C/C++ (nếu có sử dụng NDK)
.externalNativeBuild/
.cxx/

# ============
# File rác hệ điều hành
# ============
# File tự sinh của hệ điều hành macOS để lưu vị trí hiển thị icon trong thư mục
.DS_Store

# ============
# Cấu hình file vscode của riêng từng máy 
# ============
.vscode/

# ============
# Backend Python & SQLite temporary files
# ============
backend/venv/
backend/.env
backend/__pycache__/
backend/*/__pycache__/
*.py[cod]
*$py.class
backend/.pytest_cache/
*.db
*.db-journal
*.db-wal
*.db-shm
backend/static/uploads/*
!backend/static/uploads/.gitkeep
